{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Design System</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Mono:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n  <style>\n    /* ── CSS Variables ─────────────────────────────────── */\n    :root {\n      --color-ink:       #1a1714;\n      --color-paper:     #f5f0e8;\n      --color-accent:    #c84b31;\n      --color-muted:     #8a7f72;\n      --color-surface:   #edeae2;\n      --color-border:    #d4cfc6;\n\n      --font-display:    'Playfair Display', Georgia, serif;\n      --font-mono:       'DM Mono', 'Courier New', monospace;\n\n      --space-xs:        0.375rem;\n      --space-sm:        0.75rem;\n      --space-md:        1.25rem;\n      --space-lg:        2.5rem;\n      --space-xl:        5rem;\n\n      --radius-sm:       4px;\n      --radius-md:       10px;\n\n      --transition:      180ms ease;\n    }\n\n    /* ── Reset ─────────────────────────────────────────── */\n    *, *::before, *::after { box-sizing: border-box; margin: 0; }\n    body {\n      background: var(--color-paper);\n      color: var(--color-ink);\n      font-family: var(--font-mono);\n      font-size: 15px;\n      line-height: 1.65;\n      padding: var(--space-xl) var(--space-lg);\n    }\n\n    /* ════════════════════════════════════════════════════\n       CLASS 1 · .heading\n       ════════════════════════════════════════════════════ */\n    .heading {\n      font-family: var(--font-display);\n      font-size: clamp(2rem, 5vw, 3.5rem);\n      font-weight: 700;\n      line-height: 1.1;\n      letter-spacing: -0.02em;\n      color: var(--color-ink);\n      border-bottom: 2px solid var(--color-accent);\n      padding-bottom: var(--space-sm);\n      margin-bottom: var(--space-md);\n    }\n\n    /* ════════════════════════════════════════════════════\n       CLASS 2 · .card\n       ════════════════════════════════════════════════════ */\n    .card {\n      background: var(--color-surface);\n      border: 1px solid var(--color-border);\n      border-radius: var(--radius-md);\n      padding: var(--space-lg);\n      box-shadow: 4px 4px 0 var(--color-border);\n      transition: box-shadow var(--transition), transform var(--transition);\n    }\n    .card:hover {\n      transform: translate(-2px, -2px);\n      box-shadow: 6px 6px 0 var(--color-accent);\n    }\n\n    /* ════════════════════════════════════════════════════\n       CLASS 3 · .btn\n       ════════════════════════════════════════════════════ */\n    .btn {\n      display: inline-block;\n      font-family: var(--font-mono);\n      font-size: 0.8rem;\n      font-weight: 500;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      color: var(--color-paper);\n      background: var(--color-ink);\n      border: 2px solid var(--color-ink);\n      border-radius: var(--radius-sm);\n      padding: var(--space-sm) var(--space-md);\n      cursor: pointer;\n      text-decoration: none;\n      transition: background var(--transition), color var(--transition);\n    }\n    .btn:hover {\n      background: var(--color-accent);\n      border-color: var(--color-accent);\n    }\n\n    /* ════════════════════════════════════════════════════\n       CLASS 4 · .tag\n       ════════════════════════════════════════════════════ */\n    .tag {\n      display: inline-block;\n      font-family: var(--font-mono);\n      font-size: 0.72rem;\n      font-weight: 400;\n      letter-spacing: 0.06em;\n      color: var(--color-muted);\n      background: transparent;\n      border: 1px solid var(--color-border);\n      border-radius: 999px;\n      padding: var(--space-xs) var(--space-sm);\n      transition: border-color var(--transition), color var(--transition);\n    }\n    .tag:hover {\n      border-color: var(--color-accent);\n      color: var(--color-accent);\n    }\n\n    /* ════════════════════════════════════════════════════\n       CLASS 5 · .quote\n       ════════════════════════════════════════════════════ */\n    .quote {\n      font-family: var(--font-display);\n      font-style: italic;\n      font-size: 1.3rem;\n      color: var(--color-ink);\n      border-left: 4px solid var(--color-accent);\n      padding: var(--space-sm) var(--space-md);\n      margin: var(--space-lg) 0;\n      background: linear-gradient(to right, var(--color-surface), transparent);\n    }\n    .quote cite {\n      display: block;\n      margin-top: var(--space-xs);\n      font-style: normal;\n      font-family: var(--font-mono);\n      font-size: 0.78rem;\n      letter-spacing: 0.08em;\n      color: var(--color-muted);\n    }\n\n    /* ── Demo layout ────────────────────────────────────── */\n    .demo-section {\n      max-width: 680px;\n      margin: 0 auto;\n    }\n    .demo-label {\n      font-size: 0.7rem;\n      letter-spacing: 0.14em;\n      text-transform: uppercase;\n      color: var(--color-muted);\n      margin-bottom: var(--space-xs);\n      margin-top: var(--space-lg);\n    }\n    .tag-row { display: flex; gap: var(--space-xs); flex-wrap: wrap; }\n    .btn-row  { display: flex; gap: var(--space-sm); flex-wrap: wrap; align-items: center; }\n  </style>\n</head>\n<body>\n  <div class=\"demo-section\">\n\n    <p class=\"demo-label\">01 · .heading</p>\n    <h1 class=\"heading\">The Design System</h1>\n\n    <p class=\"demo-label\">02 · .card</p>\n    <div class=\"card\">\n      <p>A minimal card component. Hover to see the accent shadow shift. Works great for content blocks, media previews, or data summaries.</p>\n    </div>\n\n    <p class=\"demo-label\">03 · .btn</p>\n    <div class=\"btn-row\">\n      <button class=\"btn\">Primary</button>\n      <button class=\"btn\">Get Started</button>\n    </div>\n\n    <p class=\"demo-label\">04 · .tag</p>\n    <div class=\"tag-row\">\n      <span class=\"tag\">typography</span>\n      <span class=\"tag\">color</span>\n      <span class=\"tag\">spacing</span>\n      <span class=\"tag\">motion</span>\n    </div>\n\n    <p class=\"demo-label\">05 · .quote</p>\n    <blockquote class=\"quote\">\n      Good design is as little design as possible.\n      <cite>— Dieter Rams</cite>\n    </blockquote>\n\n  </div>\n</body>\n</html>"
}